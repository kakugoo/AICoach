POSTGRES_DB=cs2analytics
POSTGRES_USER=cs2analytics
POSTGRES_PASSWORD=local-development-only
DATABASE_URL=postgresql+psycopg://cs2analytics:local-development-only@127.0.0.1:5432/cs2analytics
NEXT_PUBLIC_API_URL=http://localhost:8000
COOKIE_SECURE=false

# Optional FACEIT Data API server-side key (leave empty to disable search)
FACEIT_API_KEY=

# Local demo storage limits
DEMO_STORAGE_DIR=../storage/demos
DEMO_MAX_BYTES=1073741824
DEMO_MAX_UNCOMPRESSED_BYTES=1073741824
DEMO_QUOTA_BYTES=4294967296
DEMO_TIMEOUT_SECONDS=600
